config BOARD_BBP9981
    bool "bbp9981"
    depends on SOC_NRF52840_QIAA

menu "A320 Trackpad Setting"

config A320_TRACKPAD_SCROLL_INTERVAL
    int "Legacy trackpad scroll interval (currently unused)"
    default 50
    range 0 200
    help
      Retained for compatibility. The A320 driver currently uses its existing
      40 ms sample-count window; this legacy value does not change scroll speed.

config A320_LOG_LEVEL
    int "Log Level for Touch"
    default 4

config A320
    bool "A320 Driver"
    depends on I2C && GPIO
    help
      A320 optical X/Y movement sensor used by the 9981 Pro trackpad.

config INPUT_A320_INIT_PRIORITY
    int "A320 Initialization Priority"
    default 90

config A320_CONTACT_PROBE
    bool "Read-only contact diagnostics (no tap-click output)"
    depends on I2C && ZMK_USB && UART_LINE_CTRL
    default n

config A320_CONTACT_PROBE_INTERVAL_MS
    int "Contact diagnostic polling interval in milliseconds"
    depends on A320_CONTACT_PROBE
    default 20
    range 20 500

config A320_BUS_COMPARE
    bool "Compare reg00 pointer/read transaction methods (read-only)"
    depends on A320_CONTACT_PROBE
    default n

config A320_BUS_COMPARE_INTERVAL_MS
    int "Transaction comparison interval"
    depends on A320_BUS_COMPARE
    default 500
    range 200 2000

config A320_TAP_OUTPUT
    bool "Compile mouse click bridge and transport snapshots"
    depends on ZMK_POINTING && I2C && GPIO && (ZMK_USB || ZMK_BLE)
    default n
    help
      Compile the real verified-contact/FSM/output bridge and SDK snapshots.
      This is NOT confirmation of a 9380 contact protocol. Unknown providers
      remain disabled and produce no synthetic clicks.

config A320_MICROTAP
    bool "Experimental opt-in motion gesture with left shoulder triple toggle"
    depends on A320_TAP_OUTPUT
    default n
    help
      Compile the micro-motion gesture buffer. Runtime is OFF after reboot.
      Default-layer left shoulder triple tap toggles it without a sensor probe.
      This is a motion heuristic, not verified finger contact recognition.

config A320_CURSOR_STEADY
    bool "Bounded mouse jitter/spike filter and BLE burst coalescing"
    depends on BOARD_BBP9981 && ZMK_POINTING && I2C && GPIO
    default n
    help
      Apply one-count per-axis hysteresis and the four-slow-sample spike
      limiter only to committed ordinary cursor motion, before fixed gain.
      Tap classification, scroll and gamepad keep their original raw input.
      BLE may merge adjacent same-direction XY in a 10 ms admission window;
      button/zero/wheel reports remain ordered barriers, without extra delay.

config BBP9981_CURSOR_SPEED
    bool "Five persistent ordinary mouse gain presets"
    depends on BOARD_BBP9981 && ZMK_POINTING && SETTINGS
    default n
    help
      UPPER Z cycles 0.6/0.9/1.2/1.5/1.8 gain; default 1.2 and Ctrl half.
      Save the last preset using an independent, debounced settings key.
      Scroll/gamepad keep their original gain; no sensor DPI register writes.

config BBP9981_MEDIA_BREATHE
    bool "Slow MEDIA keyboard backlight breathing"
    depends on BOARD_BBP9981 && ZMK_RGB_UNDERGLOW && LED_PWM
    default n
    help
      Only MEDIA changes from flashing to a 3.6 second triangular breath.
      Keep the user's brightness/off state, idle and other layer patterns.

config BBP9981_MENU_DIAG
    bool "Bounded menu/left-button chain diagnostics"
    depends on BOARD_BBP9981 && A320_TAP_OUTPUT && LOG
    default n
    help
      Observe only three matrix keys, GUI/button snapshots and mouse TX outcomes.
      Does not change GPIO, HID descriptors, key behavior or transport preference.

config BBP9981_GAMEPAD
    bool "Xbox-layout standard HID gamepad on MEDIA layer"
    depends on BOARD_BBP9981 && (ZMK_USB || ZMK_BLE)
    default n
    help
      Add report ID4 and a gamepad behavior without using keyboard keycodes.
      USB uses its own HID_1 interface; BLE appends an encrypted input report.
      Requires matching bindings. Relative trackpad motion drives one stick
      at a time; LT/RT are digital. This is not native XInput and has no rumble.

endmenu
