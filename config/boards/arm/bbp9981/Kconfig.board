config BOARD_BBP9981
    bool "bbp9981"
    depends on SOC_NRF52840_QIAA

menu "A320 Trackpad Setting"

config A320_TRACKPAD_SCROLL_INTERVAL
    int "Legacy trackpad scroll interval (currently unused)"
    default 50
    range 0 200
    help
      Retained for compatibility. The A320 driver currently uses its existing
      40 ms sample-count window; this legacy value does not change scroll speed.

config A320_LOG_LEVEL
    int "Log Level for Touch"
    default 4

config A320
    bool "A320 Driver"
    depends on I2C && GPIO
    help
      A320 optical X/Y movement sensor used by the 9981 Pro trackpad.

config INPUT_A320_INIT_PRIORITY
    int "A320 Initialization Priority"
    default 90

endmenu
