#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define MEDIA 3

#define SL_MO(layer) &sl_mo layer layer //tap -> sticky layer, hold -> momentary layer

&sl {
    release-after-ms = <3000>;
    };

/ {
    behaviors {
        microtap_shoulder: microtap_shoulder {
            compatible = "zmk,behavior-microtap-shoulder";
            #binding-cells = <0>;
            display-name = "Mouse shoulders: logical L/R roles follow inverted mode";
        };
        aa_sym_ctrl: aa_sym_ctrl {
            compatible = "zmk,behavior-aa-sym-ctrl";
            #binding-cells = <0>;
            display-name = "aA held: SYM Ctrl";
        };
        gamepad: gamepad {
            compatible = "zmk,behavior-gamepad";
            #binding-cells = <1>;
            display-name = "Xbox-layout standard HID gamepad";
        };
        aa_scroll_gesture_key: aa_scroll_gesture_key {
            compatible = "zmk,behavior-aa-scroll-gesture-key";
            #binding-cells = <0>;
            display-name = "aA: BlackBerry/Back triple-tap and mouse flip shortcut";
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&bootloader>, <&out OUT_TOG>;
        };
    };

    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp SEMI>, <&to SYM>;
        };
    };

    behaviors {
        tdc_to_MEDIA: td_mute_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp C_MUTE>, <&to MEDIA>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
    sl_mo: behavior_sl_mo {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      /* hold wins when another key is pressed */
        tapping-term-ms = <450>;       /* 长按阈值 */
        bindings = <&mo &sl>;          /* hold=MO, tap=SL */
        };
    };

    behaviors {
    sk_kp: behavior_sk_kp {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";
        tapping-term-ms = <450>;
        bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };

    behaviors {
        aa_scroll_shoulder: behavior_aa_scroll_shoulder {
            compatible = "zmk,behavior-aa-scroll-shoulder";
            #binding-cells = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
//         --------------------------------------------------------------------------------------------------------------------------
//         |    Shoulder Key1    |                                                                             |    Shoulder Key2    |
// |         Call key      |      Blackberry Key        |    Trackpad    |             Back Key                |             Endcall Key          |
// |     Q      |     W    |     E    |     R    |      T      |       Y        |       U        |        I        |       O      |      P        |
// |     A      |     S    |     D    |     F    |      G      |       H        |       J        |        K        |       L      |      ←        |
// |     alt    |     Z    |     X    |     C    |      V      |       B        |       N        |        M        |       $      |    Enter      |
//        |         aA     |         0           |           SPACE              |         SYM         |        aA          |
//        -----------------------------------------------------------------------------------------------------------------

                 &microtap_shoulder                                                                                 &microtap_shoulder
    &kp CLCK                &kp LGUI                            &mkp LCLK                          &mt ESC K_BACK                    &mt F4 TAB
    &kp Q        &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A        &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &kp BSPC
    &kp LSHFT    &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &tdc_to_SYM      &kp ENTER
    &sk_kp LCTRL  LCTRL     &kp LALT                            &kp SPACE                          &sl_mo 1 1                        &sl_mo 2 2
            >;
        };


        sym_layer {

            bindings = <
                 &kp C_VOL_UP                                                                                       &kp C_VOL_DN
    &kp PSCRN               &kp C_AC_SEARCH                     &mkp LCLK                          &kp F5                            &kp F12
    &kp HASH     &kp N1     &kp N2      &kp N3    &mt LBKT LPAR &mt RBKT RPAR     &kp UNDER        &kp MINUS        &kp PLUS         &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH     &kp COLON         &kp SEMI         &kp APOS         &kp DQT          &kp DEL
    &kp LSHFT    &kp N7     &kp N8      &kp N9    &kp QMARK     &kp EXCL          &kp COMMA        &kp DOT          &tdc_to_MEDIA    &kp ENTER
    &kp LCTRL               &kp N0                              &kp SPACE                          &to DEFAULT                       &sl_mo 2 2
            >;
        };

        upper_layer {
            /* Double-tap right aA locks scrolling unrotated and pins UPPER; SYM exits.
             * Locked shoulders halve trackpad wheel and suppress native shoulder scroll.
             * Triple BlackBerry maps left->up; triple top Back maps right->up. While locked,
             * these keys are gesture-only. Hold right aA and double-tap top Back to toggle
             * volatile inverted-mouse mode; it does not alter scroll or gamepad behavior. */
            bindings = <
                 &aa_scroll_shoulder SCRL_UP                                                                               &aa_scroll_shoulder SCRL_DOWN
    &bt BT_SEL 0            &aa_scroll_gesture_key                        &td0                              &aa_scroll_gesture_key           &bt BT_SEL 3
    &out OUT_BLE &kp UP     &kp C_EJECT &sys_reset      &ext_power EP_TOG &none            &kp LT           &kp GT          &kp PIPE         &kp KP_EQUAL
    &kp LEFT     &kp DOWN   &kp RIGHT   &none           &kp BSLH          &kp AMPS         &kp LBRC         &kp RBRC        &kp CARET        &kp BSPC
    &kp LSHFT    &none      &none       &rgb_ug RGB_BRD &bl BL_DEC        &rgb_ug RGB_TOG  &bl BL_INC       &rgb_ug RGB_BRI &td_boot_out     &kp ENTER
    &kp LCTRL               &kp LALT                                      &kp  SPACE                        &aa_sym_ctrl                     &to UPPER
            >;
        };

        media_layer {
            /* Xbox-layout standard HID, not XInput. E/X/A/F=Dpad up/down/left/right;
             * D=L3, L=R3; O/K/Backspace/$=Y/X/B/A. Trackpad click P4 and Space P39=Guide14;
             * BB P3 selects the right stick while held. P0/P1=LB/RB, Call/End=LT/RT;
             * T/Y=View/Menu. Only SYM and right aA exit MEDIA. */
            bindings = <
                 &gamepad 8                                                                              &gamepad 9
    &gamepad 10            &gamepad 17                         &gamepad 14                    &none                            &gamepad 11
    &none        &none     &gamepad 0 &none       &gamepad 12  &gamepad 13   &none           &none           &gamepad 7      &none
    &gamepad 2   &none      &gamepad 15 &gamepad 3 &none     &none         &none           &gamepad 6      &gamepad 16     &gamepad 5
    &none        &none     &gamepad 1 &none      &none        &none         &none           &none           &gamepad 4      &none
    &none                  &none                               &gamepad 14                   &to DEFAULT                      &to DEFAULT
            >;
        };
    };
};
